# Обязательный. API-ключ. Если используете neuroapi.host — ключ из их личного кабинета.
OPENAI_API_KEY=sk-...

# Эндпоинт OpenAI-совместимого провайдера.
# Для neuroapi.host укажите base URL из их кабинета (обычно вида https://neuroapi.host/v1).
# Оставьте пустым, чтобы обращаться напрямую к api.openai.com.
OPENAI_BASE_URL=

# Опциональный. Если задан — доступ к demo только по /?token=...
DEMO_ACCESS_TOKEN=
